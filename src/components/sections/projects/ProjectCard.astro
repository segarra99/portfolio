---
import Window from "../../ui/Window.astro";
import type { Project } from "../../../data/projects";

type Props = {
    project: Project;
};
const { title, media, description, technologies, live, code, product } =
    Astro.props.project;
---

<article>
    <Window title={title.toLowerCase() + "/"}>
        {media.endsWith(".webm") ? (
            <video src={media} class="media" autoplay loop muted playsinline />
        ) : (
            <img
                src={media}
                class="media"
                alt={`${title} project screenshot`}
            />
        )}
        <div class="info">
            <div>
                <h3>{title}</h3>
                <p>{description}</p>
            </div>
            <div>
                <ul>
                    {technologies.map((tech) => (
                        <li>{tech}</li>
                    ))}
                </ul>
                <nav aria-label={`${title} links`}>
                    {live && (
                        <a
                            href={live}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {"> live"}
                        </a>
                    )}
                    {code && (
                        <a
                            href={code}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {"> code"}
                        </a>
                    )}
                    {product && (
                        <a
                            href={product}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {"> product"}
                        </a>
                    )}
                </nav>
            </div>
        </div>
    </Window>
</article>

<style>
    article {
        display: flex;
        height: 100%;
    }

    h3 {
        color: var(--accent2);
        font-weight: 500;
        margin: 0 0 0.4rem;
    }

    p {
        color: var(--sub);
        margin: 0 0 0.75rem;
    }

    ul {
        display: flex;
        flex-wrap: wrap;

        li {
            color: var(--accent1);
            font-size: 1.25rem;
            border: 2px solid var(--accent1);
            padding: 0 0.5rem;
            margin: 0 0.4rem 0.4rem 0;
        }
    }

    nav {
        color: var(--accent1);
        margin-top: 0.4rem;

        a {
            &:focus-visible,
            &:active {
                color: var(--panel);
                background-color: var(--accent1);
            }
        }
    }

    .media {
        display: block;
        aspect-ratio: 16 / 9;
        border-bottom: 3px solid var(--border);

        video& {
            width: 100%;
            object-fit: fill;
        }
    }

    .info {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1rem;
        flex-grow: 1;
    }

    @media (hover: hover) {
        ul li:hover {
            color: var(--accent2);
            border-color: var(--accent2);
            user-select: none;
        }

        nav a:hover {
            color: var(--panel);
            background-color: var(--accent1);
        }
    }
</style>
