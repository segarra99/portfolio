---
import Window from "../ui/Window.astro";
---

<section id="hero">
    <header>
        <Window title="photo.png">
            <div class="frame">
                <img
                    src="/media/profile_pic.webp"
                    alt="Profile picture"
                    width="340"
                    height="340"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </div>
        </Window>
        <div class="intro">
            <span>$ whoami</span>
            <h1>
                MANUEL
                <br />
                SEGARRA
            </h1>
            <h2>software-engineer</h2>
            <p>
                Working across frontend and backend development, cloud
                infrastructure, and software architecture. Turning technical
                requirements into reliable, scalable systems.
            </p>
            <nav aria-label="Introduction">
                <a href="#projects">./projects</a>
                <a href="/assets/cv.pdf" download="manuel-segarra-cv.pdf">
                    cv.pdf
                </a>
            </nav>
        </div>
    </header>
    <dl>
        <div class="card">
            <dt>experience</dt>
            <dd>3+ years</dd>
        </div>
        <div class="card">
            <dt>location</dt>
            <dd>Lisbon, PT</dd>
        </div>
        <div class="card">
            <dt>languages</dt>
            <dd>PT, EN</dd>
        </div>
        <div class="card">
            <dt>timezone</dt>
            <dd>
                <span class="timezone-full">WET (UTC+0/+1)</span>
                <span class="timezone-short">UTC+0/+1</span>
            </dd>
        </div>
    </dl>
</section>

<style>
    header {
        display: grid;
        grid-template-columns: 1fr;
        justify-items: center;
        gap: 1.5rem;
    }

    h1 {
        font-size: clamp(3rem, 6vw, 6.5rem);
        font-weight: 400;
        letter-spacing: 0.15rem;
        line-height: 1;
        margin: 0 0 1rem;
    }

    h2 {
        font-size: clamp(1.6rem, 2.6vw, 2.4rem);
        font-weight: 500;
        color: var(--accent2);
        margin: 0 0 0.7rem;
    }

    nav {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;

        a {
            background-color: var(--accent2);
            color: var(--panel);
            border: 3px solid var(--border);
            padding: 0.5rem 1.2rem;
            text-align: center;
            box-shadow: 5px 5px var(--shadow);

            &:focus-visible,
            &:active {
                background-color: var(--accent1);
                box-shadow: 3px 3px 0 var(--shadow);
                transform: translate(2px, 2px);
            }

            &[download] {
                background-color: var(--panel);
                color: var(--border);
            }
        }
    }

    dl {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.2rem;
        margin-top: 3rem;

        .card {
            background-color: var(--panel);
            border: 3px solid var(--border);
            box-shadow: 5px 5px var(--shadow);
            padding: 0.5rem 0.6rem;

            dt {
                color: var(--accent1);
                font-size: 1.15rem;
                margin-bottom: 0.1rem;
            }

            dd {
                color: var(--accent2);
                margin: 0;
            }
        }
    }

    .frame {
        padding: 1.2rem;

        img {
            width: clamp(160px, 20vw, 340px);
            height: auto;
            outline: 3px dashed var(--accent1);
        }
    }

    .intro {
        span {
            display: block;
            color: var(--accent1);
            margin-bottom: 0.6rem;
        }

        p {
            color: var(--sub);
            margin: 0 0 1.75rem;
        }
    }

    .timezone-full {
        display: none;
    }

    @media (min-width: 420px) {
        .timezone-full {
            display: inline;
        }

        .timezone-short {
            display: none;
        }
    }

    @media (min-width: 760px) {
        header {
            grid-template-columns: 1.5fr 1fr;
            align-items: center;

            .intro {
                grid-row: 1;
                grid-column: 1;

                nav {
                    flex-direction: row;
                }
            }
        }
    }

    @media (min-width: 840px) {
        dl {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @media (hover: hover) {
        nav a:hover {
            background-color: var(--accent1);
            box-shadow: 3px 3px 0 var(--shadow);
            transform: translate(2px, 2px);
        }
    }
</style>
