---
const links = [
    { href: "/#about", label: "./about" },
    { href: "/#projects", label: "./projects" },
    { href: "/#experience", label: "./experience" },
    { href: "/#skills", label: "./skills" },
    { href: "/#contact", label: "./contact" },
];
---

<nav aria-label="Main navigation">
    <a class="brand" href={Astro.url.pathname === "/" ? "#top" : "/"}>
        segarra@dev:~$
    </a>

    <button
        class="menu-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="nav-links"
    >
        [ menu ]
    </button>

    <ul class="nav-links" id="nav-links">
        {links.map(({ href, label }) => (
            <li>
                <a href={href}>{label}</a>
            </li>
        ))}
        <li class="theme-toggle">
            <span></span>
            <button type="button" aria-label="Switch theme"></button>
        </li>
    </ul>
</nav>

<script>
    // menu
    const menuToggle =
        document.querySelector<HTMLButtonElement>(".menu-toggle");
    const navLinks = document.querySelector<HTMLUListElement>(".nav-links");

    if (menuToggle && navLinks) {
        const closeMenu = (restoreFocus = false) => {
            navLinks.classList.remove("open");
            menuToggle.textContent = "[ menu ]";
            menuToggle.setAttribute("aria-expanded", "false");
            menuToggle.setAttribute("aria-label", "Open navigation");

            if (restoreFocus) {
                menuToggle.focus();
            }
        };

        menuToggle.addEventListener("click", () => {
            const isOpen = navLinks.classList.toggle("open");
            menuToggle.textContent = isOpen ? "[ close ]" : "[ menu ]";
            menuToggle.setAttribute("aria-expanded", String(isOpen));
            menuToggle.setAttribute(
                "aria-label",
                isOpen ? "Close navigation" : "Open navigation",
            );
        });

        navLinks.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => closeMenu());
        });

        document.addEventListener("click", (event) => {
            const target = event.target;

            if (
                target instanceof Node &&
                !navLinks.contains(target) &&
                !menuToggle.contains(target)
            ) {
                closeMenu();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && navLinks.classList.contains("open")) {
                closeMenu(true);
            }
        });
    }

    // theme
    const themeToggle = document.querySelector<HTMLButtonElement>(
        ".theme-toggle button",
    );
    const root = document.documentElement;
    const themeColor = document.querySelector<HTMLMetaElement>(
        'meta[name="theme-color"]',
    );

    if (themeToggle) {
        const updateThemeButton = () => {
            const currentTheme =
                root.dataset.theme ||
                (matchMedia("(prefers-color-scheme: light)").matches
                    ? "light"
                    : "dark");
            const nextTheme = currentTheme === "light" ? "dark" : "light";

            themeToggle.textContent = `[${currentTheme}]`;
            themeToggle.setAttribute(
                "aria-label",
                `Switch to ${nextTheme} theme`,
            );

            const panelColor = getComputedStyle(document.documentElement)
                .getPropertyValue("--panel")
                .trim();

            themeColor?.setAttribute("content", panelColor);
        };

        updateThemeButton();

        themeToggle.addEventListener("click", () => {
            root.classList.add("theme-switch");

            const theme =
                (root.dataset.theme ||
                    (matchMedia("(prefers-color-scheme: light)").matches
                        ? "light"
                        : "dark")) === "light"
                    ? "dark"
                    : "light";
            root.dataset.theme = theme;
            try {
                localStorage.setItem("theme", theme);
            } catch {}

            updateThemeButton();

            setTimeout(() => {
                root.classList.remove("theme-switch");
            }, 500);
        });
    }
</script>

<style>
    nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
    }

    .brand {
        color: var(--accent2);
        font-size: clamp(1.5rem, 7vw, 1.75rem);
        white-space: nowrap;

        &::after {
            content: "";
            display: inline-block;
            width: 0.7rem;
            height: 1.2rem;
            vertical-align: -0.1em;
            background: var(--accent1);
            animation: blink 1s steps(2, start) infinite;
        }

        &:focus-visible,
        &:active {
            background: var(--accent1);
            color: var(--panel);
        }
    }

    .menu-toggle {
        padding: 0.34rem clamp(0.5rem, 2.8vw, 0.9rem);
        border: 3px solid var(--border);
        white-space: nowrap;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        flex-direction: column;
        border-bottom: 3px solid var(--border);
        background: var(--panel);
        box-shadow: 0 6px 0 var(--shadow);

        &.open {
            display: flex;
        }

        a {
            display: block;
            padding: 0.9rem 1.5rem;
            border-top: 2px dashed var(--line);

            &:focus-visible,
            &:active {
                background: var(--accent1);
                color: var(--panel);
                border-color: var(--accent1);
            }
        }
    }

    .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 0.5rem 1.5rem;
        border-top: 3px solid var(--border);

        span::before {
            content: "theme";
            color: var(--dim);
        }

        button {
            padding: 0.2rem 0.8rem;
            border: 2px solid transparent;
            color: var(--accent1);
            transform: none;
            box-shadow: none;

            &:focus-visible,
            &:active {
                border-color: var(--accent2);
            }
        }
    }

    @keyframes blink {
        to {
            visibility: hidden;
        }
    }

    @media (min-width: 1080px) {
        .menu-toggle {
            display: none;
        }

        .nav-links {
            display: flex;
            position: static;
            flex-direction: row;
            align-items: center;
            gap: 0.3rem;
            border: none;
            box-shadow: none;
            margin-block: 0.15rem;

            a {
                padding: 0.25rem 0.8rem;
                border: 2px solid transparent;

                &:focus-visible,
                &:active {
                    border-color: var(--accent2);
                    background: transparent;
                    color: var(--accent2);
                }
            }
        }

        .theme-toggle {
            width: auto;
            padding: 0;
            border: none;
            gap: 0.3rem;

            span {
                display: block;
                height: 1.8rem;
                margin-inline: 0.5rem;
                border-left: 2px dashed var(--line);

                &::before {
                    content: none;
                }
            }
        }
    }

    @media (hover: hover) {
        .brand:hover {
            background: var(--accent1);
            color: var(--panel);
        }

        .nav-links a:hover {
            background: var(--accent1);
            color: var(--panel);
            border-color: var(--accent1);
        }

        .theme-toggle button:hover {
            border-color: var(--accent2);
        }
    }

    @media (min-width: 1080px) and (hover: hover) {
        .nav-links a:hover {
            border-color: var(--accent2);
            background: transparent;
            color: var(--accent2);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .brand::after {
            animation: none;
        }
    }
</style>
